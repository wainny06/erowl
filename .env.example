SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Optional: existing server key can be retained if configured.
# SUPABASE_SECRET_KEY=
# Random 32+ character token used only by Vercel Cron, not a login password.
CRON_SECRET=
# Private Vercel Blob: automatic BLOB_STORE_ID + VERCEL_OIDC_TOKEN,
# or BLOB_READ_WRITE_TOKEN. Use the variables supplied by your Blob connection.
