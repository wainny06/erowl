SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server-only Supabase secret key (sb_secret_...) or legacy service_role key.
SUPABASE_SECRET_KEY=
# Shared login password, minimum 12 characters. Never prefix with NEXT_PUBLIC_.
STOCK_PASSWORD=
# Random 32+ character token used only by Vercel Cron.
CRON_SECRET=
# Connect a PRIVATE Vercel Blob store to the Production project.
BLOB_READ_WRITE_TOKEN=
